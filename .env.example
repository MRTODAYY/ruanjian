# ===== Code Review Agent 配置文件 =====
# 复制本文件为 .env 并填入你自己的密钥。
# 程序启动时会自动读取同目录（或上级目录）下的 .env 文件。

# --- LLM 服务商（OpenAI 兼容接口）---
# DeepSeek:  https://api.deepseek.com         模型 deepseek-chat
# OpenAI:    https://api.openai.com/v1        模型 gpt-4o-mini
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 本地Ollama:http://localhost:11434/v1        模型 qwen2.5-coder
CODEAGENT_BASE_URL=https://api.deepseek.com
CODEAGENT_API_KEY=sk-your-key-here
CODEAGENT_MODEL=deepseek-chat

# --- Agent 行为参数 ---
# Agent 循环最大步数（防止无限循环）
CODEAGENT_MAX_STEPS=12
# LLM 请求失败重试次数
CODEAGENT_MAX_RETRIES=4
# 单次请求超时（秒）
CODEAGENT_TIMEOUT=120
# 采样温度，代码审查建议偏低
CODEAGENT_TEMPERATURE=0.2

# --- 工具安全限制 ---
# 允许 Agent 执行代码的工具开关（true/false）
CODEAGENT_ENABLE_EXEC=true
# 代码执行超时（秒）
CODEAGENT_EXEC_TIMEOUT=15
# 允许访问的目录根（留空表示当前工作目录）
CODEAGENT_WORKSPACE=
